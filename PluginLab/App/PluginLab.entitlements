<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>platform-application</key><true/>
<key>get-task-allow</key><true/>
<key>proc_info-allow</key><true/>
<key>com.apple.private.persona-mgmt</key><true/>
<key>com.apple.private.security.no-sandbox</key><true/>
<!-- Required for own data-container access with platform-application/no-sandbox. -->
<key>com.apple.private.security.storage.AppDataContainers</key><true/>
</dict></plist>
